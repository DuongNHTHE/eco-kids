generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  password String?
  name     String
  avatar   String?

  role UserRole @default(PARENT)

  children Child[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationMembers OrganizationMember[]

  @@map("users")
}

enum UserRole {
  ADMIN
  PARENT
  TEACHER
  SCHOOL_ADMIN
}

model Child {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  parentId String @db.ObjectId
  parent   User   @relation(fields: [parentId], references: [id])

  name     String
  nickname String?
  avatar   String?

  birthDate DateTime?
  gender    String?

  level Int @default(1)

  progress LearningProgress[]
  sessions LearningSession[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  aiconversations AIConversation[]

  @@map("children")
}

model Topic {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String
  slug String @unique

  description String?
  small_img   String?
  translation String?
  icon        String?
  color       String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topics")
}

model Lesson {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  topicId String @db.ObjectId
  topic   Topic  @relation(fields: [topicId], references: [id])

  title       String
  description String?

  small_img String?

  order Int @default(0) // sort

  duration Int?

  isPremium Boolean @default(false)
  isActive  Boolean @default(true)

  vocabularies Vocabulary[]
  games        Game[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lessons")
}

model Vocabulary {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  word        String
  translation String?
  phonetic    String?
  description String?
  prompt      String?
  shape       String?
  color       String?
  models      Model3D[]

  image String?
  audio String?

  example String?

  difficulty Int @default(1)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vocabularies")
}

model Model3D {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id])
  vocabularyId String     @db.ObjectId

  name       String
  modelUrl   String
  previewUrl String?

  animation Json?

  scale    Float?
  rotation Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("model_3ds")
}

model QRCode {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  code String @unique

  targetType QRTargetType
  targetId   String

  bookId String? @db.ObjectId
  page   Int?

  isActive Boolean @default(true)

  scanCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qrcodes")
}

enum QRTargetType {
  LESSON
  VOCABULARY
  MODEL_3D
  GAME
}

model LearningProgress {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  childId String @db.ObjectId

  lessonId     String  @db.ObjectId
  vocabularyId String? @db.ObjectId

  status ProgressStatus @default(NOT_STARTED)

  progress Float @default(0)

  score   Float?
  minutes Int    @default(1)

  completedAt DateTime?

  lastAccessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id])

  @@unique([childId, lessonId])
  @@map("learning_progress")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LearningSession {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  childId String @db.ObjectId

  lessonId String? @db.ObjectId

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  duration Int?

  device String?

  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id])

  @@map("learning_sessions")
}

model PronunciationAttempt {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  childId String @db.ObjectId

  vocabularyId String @db.ObjectId

  transcript String?

  score Float

  accuracy Float?
  fluency  Float?

  feedback String?

  createdAt DateTime @default(now())

  @@map("pronunciation_attempts")
}

// chapter 2
model AIConversation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  childId String @db.ObjectId

  lessonId String? @db.ObjectId

  type AIConversationType

  title String?

  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id])

  @@map("ai_conversations")
}

model AIMessage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String @db.ObjectId

  role MessageRole

  content String

  metadata Json?

  createdAt        DateTime        @default(now())
  aiconversation   AIConversation? @relation(fields: [aIConversationId], references: [id])
  aIConversationId String?         @db.ObjectId

  @@map("ai_messages")
}

enum AIConversationType {
  CHAT
  QUESTION
  STORY
  PRONUNCIATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Game {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  title String

  type GameType

  config Json

  isPremium Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("games")
}

enum GameType {
  QUIZ
  MATCHING
  DRAG_DROP
  MEMORY
  PRONUNCIATION
  MODEL_3D
}

model SubscriptionPlan {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  price    Float
  duration Int
  features String[]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  planId String @db.ObjectId

  status SubscriptionStatus

  startedAt DateTime
  expiredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Organization {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  type    OrganizationType
  address String?

  contactName String?
  email       String?
  phone       String?

  members OrganizationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

enum OrganizationType {
  KINDERGARTEN
  ENGLISH_CENTER
  SCHOOL
}

model OrganizationMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  userId String @db.ObjectId

  role OrganizationRole

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  name      String
  subtitle  String?
  price     Float
  period    String?
  badge     String?
  color     String?
  items     String[]
  featured  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  customer  Json
  items     Json
  total     Float
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model Partner {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  organization String
  contactName  String
  phone        String
  email        String?
  studentCount Int?
  note         String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("partners")
}

enum OrganizationRole {
  ADMIN
  TEACHER
}
