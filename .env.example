PORT=1111
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/eco-kids
DATABASE_URL=mongodb://127.0.0.1:27017/eco-kids
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_AZURE_SPEECH_KEY=your_speech_key
NEXT_PUBLIC_AZURE_SPEECH_REGION=your_speech_region

GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

# Server-side AI agent. Set AI_PROVIDER to openai or gemini.
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000